<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone access under Hardened Runtime (release builds). Not sandboxed:
	     consuming CGEventTaps and synthetic paste are incompatible with App Sandbox. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
